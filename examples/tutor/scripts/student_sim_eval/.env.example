# Copy outside the public package. Never commit filled credentials.
SIM_TEACHER_MODEL=openai/gpt-5.6-luna
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional frozen ID list; leave unset for seed=42 sampling from the local test split.
SIM_QUESTION_IDS=
# JSON array: USD/million tokens [input, cache_read, cache_write, output].
# Use verified current prices. Budget covers teacher calls only, not student/aux.
SIM_TEACHER_PRICES=
SIM_STUDENT_MODEL=
STUDENT_BASE_URL=
STUDENT_API_KEY=EMPTY
SIM_AUX_MODEL=
AUX_BASE_URL=
AUX_API_KEY=EMPTY
# Optional deployment paths; omit to use protocol defaults.
# TUTOR_DATASET=
# TUTOR_TOKENIZER=
# Only needed by different-models.yaml; add further slots in your own config.
SIM_STUDENT_A_MODEL=
STUDENT_A_BASE_URL=
STUDENT_A_API_KEY=EMPTY
SIM_STUDENT_B_MODEL=
STUDENT_B_BASE_URL=
STUDENT_B_API_KEY=EMPTY
SIM_STUDENT_C_MODEL=
STUDENT_C_BASE_URL=
STUDENT_C_API_KEY=EMPTY

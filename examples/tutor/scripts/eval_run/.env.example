# Fill these in privately. EMPTY is explicit for unauthenticated local servers.
TEACHER_BASE_URL=http://127.0.0.1:30000/v1
TEACHER_API_KEY=EMPTY
STUDENT_BASE_URL=http://127.0.0.1:30001/v1
STUDENT_API_KEY=EMPTY
AUX_BASE_URL=http://127.0.0.1:30002/v1
AUX_API_KEY=EMPTY
# Adapter path or registered adapter identifier recognized by the teacher server.
TEACHER_ADAPTER=/path/to/adapter
# Optional pinned local assets:
# TUTOR_TOKENIZER=/path/to/Qwen3-8B-tokenizer-snapshot
# TUTOR_DATASET=/path/to/benchmark
